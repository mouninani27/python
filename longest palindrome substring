class Solution:
    def longestPalindrome(self, s):
        if len(s) < 2:
            return s

        start = 0
        end = 0

        for i in range(len(s)):
            left = i
            right = i

            # Odd length palindrome
            while left >= 0 and right < len(s) and s[left] == s[right]:
                if right - left > end - start:
                    start = left
                    end = right

                left -= 1
                right += 1

            left = i
            right = i + 1

            # Even length palindrome
            while left >= 0 and right < len(s) and s[left] == s[right]:
                if right - left > end - start:
                    start = left
                    end = right

                left -= 1
                right += 1

        return s[start:end + 1]
